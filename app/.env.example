# EMS ReadyKit — local environment template
#
# Copy this file to `.env` (gitignored, never commit `.env` itself) and
# adjust as needed for local development.
#
# See CONTRIBUTING.md section 3 (Environment variables) for the full list
# and section 11 (Authentication in development) for details on the fake
# test-{role} bearer tokens this setting enables.

# REQUIRE_REAL_AUTH defaults to true (secure by default) everywhere,
# including the deployed App Service. Set to false ONLY here, in your local
# .env, so the fake Bearer test-responder / test-supervisor /
# test-administrator tokens work against your local server without a real
# Azure AD tenant. Never set this to false anywhere else — see
# iac/Terraform/modules/app/main.tf for why the deployed environment sets
# it explicitly to true regardless of APP_ENV.
REQUIRE_REAL_AUTH=false

# APP_ENV only controls resource-naming/cost conventions and whether /docs
# is served — it has no effect on auth requirements. The default
# (development) is fine for local work.
# APP_ENV=development

# Uncomment and set if you want to test against a real Azure AD tenant
# locally instead of the fake test-{role} tokens (see CONTRIBUTING.md
# section 11 — a dotted token still routes to real validation even with
# REQUIRE_REAL_AUTH=false, as long as these are set):
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=

# Uncomment to point at a local/remote PostgreSQL instead of the default
# SQLite dev database:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ems_readykit_dev

# LOG_LEVEL=INFO
