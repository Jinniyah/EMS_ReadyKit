# EMS ReadyKit — environment variable template
# Copy to .env for local development. Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite (no driver required)
DATABASE_URL=sqlite:///./ems_readykit_dev.db

# Azure SQL (production) — driver string format:
# DATABASE_URL=mssql+pyodbc://<login>:<password>@<server>.database.windows.net/db-ems-readykit?driver=ODBC+Driver+18+for+SQL+Server

# ── Azure Key Vault ────────────────────────────────────────────────────────────
# Leave blank for local dev (app reads DATABASE_URL directly).
# Set in Azure App Service app settings to use managed identity KV retrieval.
KEY_VAULT_URI=

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development        # development | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
