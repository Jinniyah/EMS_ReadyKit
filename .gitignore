################################################################################
# EMS ReadyKit — .gitignore
################################################################################

# ── Visual Studio ─────────────────────────────────────────────────────────────
/.vs/EMS_ReadyKit/CopilotIndices
/.vs

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
temp*.tfvars
temp*.tfvars.json
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── Environment / secrets ─────────────────────────────────────────────────────
# IMPORTANT: .env contains local secrets — must never be committed.
# Use .env.example as the committed template.
.env
*.env
!.env.example

# ── SQLite dev database ────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Ruff / linting cache ──────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
