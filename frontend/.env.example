# EMS ReadyKit — Frontend environment variables
#
# Copy this file to .env.local for local development.
# Production values are injected at build time by GitHub Actions.
#
# ── Local development ──────────────────────────────────────────────────────────
# Leave VITE_API_BASE_URL empty — Vite dev server proxies /api/* to localhost:8000.
# Set VITE_APP_ENV=development to enable the dev auth banner and fake tokens.
VITE_API_BASE_URL=
VITE_APP_ENV=development

# ── Azure AD (required for production only) ────────────────────────────────────
# Injected by Terraform as App Service app settings — not needed locally.
# VITE_AZURE_AD_TENANT_ID=
# VITE_AZURE_AD_CLIENT_ID=
